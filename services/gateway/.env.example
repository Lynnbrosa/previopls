# =========================================================================
# PrevioPLS Security API (Gateway) — variáveis de ambiente
# =========================================================================
# Em produção: gerencie via secret manager (AWS SSM, Vault, Render Secret Files).
# NUNCA commitar valores reais. Este arquivo é só template.
# =========================================================================

APP_ENV=development
APP_NAME=previo-pls-security
APP_VERSION=1.0.0

# Prefixo público quando o nginx remove /api antes de repassar (afeta só /docs).
# No compose unificado: ROOT_PATH=/api  → Swagger em https://localhost/api/docs
ROOT_PATH=

# ---- Database ----
DATABASE_URL=postgresql+psycopg://previopls:previopls@db:5432/previopls

# ---- JWT externo (RS256 — assinatura assimétrica) ----
# Fora de produção o par é gerado automaticamente no boot se não existir
# (JWT_AUTO_GENERATE_KEYS=true por padrão). Em produção gere com
# ./scripts/gen_rsa_keys.sh e monte via secret manager.
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_ISSUER=previo-pls
JWT_AUDIENCE=previo-pls-clients
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
# JWT_AUTO_GENERATE_KEYS=true

# ---- Integração com o Core (ADR-001 / ADR-003) ----
# Com CORE_API_URL definido, /v1/clientes e /v1/leads* são repassados ao Core
# com um JWT interno HS256 assinado com JWT_SECRET (mesmo valor do Core).
# Vazio = modo standalone (o Gateway persiste o domínio no próprio banco).
CORE_API_URL=http://core:5000
JWT_SECRET=dev-only-change-me-this-key-must-be-at-least-32-bytes-long
CORE_TIMEOUT_SECONDS=5

# Cria admin@ford.com / consultor@ford.com / analista@ford.com no boot (dev/demo).
# Default: true fora de produção, false em produção.
# SEED_DEFAULT_USERS=true

# Primeiro administrador em produção (obrigatório em APP_ENV=production, senão ninguém
# consegue logar: o Gateway não tem endpoint de gestão de usuários). Criado no boot se
# não existir; a senha só é aplicada na criação. Outros usuários: python -m app.db.seed --help
# BOOTSTRAP_ADMIN_EMAIL=gestor@suaconcessionaria.com.br
# BOOTSTRAP_ADMIN_PASSWORD=troque-por-uma-senha-forte
# BOOTSTRAP_ADMIN_NAME=Gestor Pós-venda

# ---- Fernet — criptografia de PII at-rest (modo standalone) ----
# Gere com: python scripts/gen_fernet_key.py
FERNET_KEY=Z0FBQUFBQm5BQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUE=

# Chave separada para HMAC determinístico do CPF (busca por igualdade).
CPF_HASH_PEPPER=troque-em-producao-para-um-valor-aleatorio-de-32-bytes-no-minimo

# Chave compartilhada para HMAC em payloads críticos (POST /v1/clientes).
HMAC_PAYLOAD_SECRET=troque-em-producao-compartilhada-com-clientes-confiaveis

# ---- CORS — whitelist explícita (separar por vírgula) ----
CORS_ORIGINS=https://localhost,http://localhost:3000

# ---- Rate limit (por IP) ----
RATE_LIMIT_GLOBAL=100/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_LLM=10/minute

# ---- Lockout anti brute-force ----
LOCKOUT_MAX_FAILURES=5
LOCKOUT_WINDOW_SECONDS=60
LOCKOUT_DURATION_SECONDS=900

# ---- LGPD retention ----
RETENTION_YEARS=5

# ---- Webhook para alertas de segurança (opcional) ----
SECURITY_ALERT_WEBHOOK_URL=
