# Variáveis do compose unificado. Copie para .env e ajuste antes de qualquer
# ambiente que não seja a sua máquina. Em desenvolvimento os defaults do
# compose já bastam para subir a stack (docker compose up --build).

# Postgres (usado pelo core e pelo gateway)
POSTGRES_PASSWORD=previopls

# Segredo HS256 compartilhado core <-> gateway (JWT interno, ADR-003). Mínimo 32 bytes.
# Gerar: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-this-key-must-be-at-least-32-bytes-long

# AES-256-GCM do Core (Base64 de 32 bytes). O seed V3 foi cifrado com a chave dev;
# ao trocar, regenere o seed com scripts/build-seed/build_seed.py.
# Gerar: openssl rand -base64 32
APP_CRYPTO_KEY=cHJldmlvcGxzLWRldi1rZXktMzItYnl0ZXMtWFhYWFg=

# Gateway (FastAPI)
# Gerar: python services/gateway/scripts/gen_fernet_key.py
FERNET_KEY=bV9Wt8aLkV3jH2KqXoXBb1nDmYsP7vZbMHRR9G8u3jQ=
CPF_HASH_PEPPER=change-me-cpf-hash-pepper-min-32-bytes-long
# Assinatura HMAC do webhook de faturamento (POST /api/v1/clientes)
HMAC_PAYLOAD_SECRET=change-me-hmac-payload-secret-min-32-bytes
